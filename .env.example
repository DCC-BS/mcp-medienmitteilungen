# Domain of the Basel-Stadt portal serving /api/search/press-releases and
# /api/graphql/query/routeNodePressRelease. Defaults to www.bs.ch when unset.
BS_DOMAIN=www.bs.ch

# Optional: base URL the server fetches from, when it differs from
# https://<domain> inside the deployment. Links in tool results keep using
# https://<domain>.
BS_API_URL=

# Seconds the organization facet list is kept in memory before refetching.
ORG_CACHE_TTL=3600

# Host header allowed past DNS-rebinding protection on the MCP HTTP endpoint.
# Add the public hostname(s) this deployment is served under (comma-separated,
# port wildcard allowed), e.g. MCP_ALLOWED_HOSTS="mcp-medienmitteilungen.statistik.bs.ch".
# Leave empty or unset to disable Host validation.
MCP_ALLOWED_HOSTS=
